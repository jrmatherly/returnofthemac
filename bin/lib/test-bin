#!/bin/bash
#
# Self-check for small bin/ scripts (serve, git-find, git-tidy, obsidian-vault, push, pull) in a scratch HOME and git repo.
#
# - Run it (pnpm check does too); exits 1 when an assertion fails:
#
# `test-bin`
#
# ---
# Never touches the real HOME: HOME is a temp dir, and the git checks run in
# $tmp/repo (main, a merged domain-fix and an unmerged wip).
#
# License: MIT

set -u

root="$(cd "$(dirname "$0")/.." && pwd -P)"
root="${root%/bin}"
tmp=$(mktemp -d)
port=8099
serve_pid=""
trap '[ -z "$serve_pid" ] || kill "$serve_pid" 2> /dev/null; rm -rf "$tmp"' EXIT
# mise's shims stay off PATH, as on CI: under a fake HOME one starts cold and
# fetches every tool's versions from the network before it runs anything
PATH=$(tr ':' '\n' <<< "$PATH" | grep -v '/mise/shims$' | paste -sd: -)
export HOME="$tmp/home" GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
mkdir -p "$HOME"
fails=0

check() {
  if eval "$2"; then echo "ok   $1"; else
    echo "FAIL $1"
    fails=$((fails + 1))
  fi
}

(
  cd "$tmp" && git init -q -b main repo && cd repo || exit 1
  mkdir sub && echo a > top.txt && echo b > sub/inner.txt
  git add . && git commit -qm one
  git branch domain-fix
  echo c >> top.txt && git commit -qam two
  git checkout -qb wip && echo d >> top.txt && git commit -qam three
  git checkout -q main
)

# Both the subshell and serve exec, so $! is the python server itself
(cd "$tmp" && SERVE_NO_OPEN=1 exec "$root/bin/serve" "$port" > /dev/null 2>&1) &
serve_pid=$!
code=000
for _ in $(seq 50); do
  code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/" 2> /dev/null)
  [ "$code" = 200 ] && break
  sleep 0.1
done
check "serve answers" "[ '$code' = 200 ]"

check "git-find top-level" "(cd '$tmp/repo' && '$root/bin/git-find' top.txt | grep -qx top.txt)"
check "git-find nested" "(cd '$tmp/repo' && '$root/bin/git-find' inner.txt | grep -qx sub/inner.txt)"
# A bare set -u crash also exits non-zero, so require the usage line too
check "git-find usage" "! '$root/bin/git-find' > /dev/null 2> '$tmp/err' && grep -q '^usage: git-find' '$tmp/err'"

dropped=$(cd "$tmp/repo" && echo e >> top.txt && git stash -q && git rev-parse 'stash@{0}' && git stash drop -q)
(cd "$tmp/repo" && "$root/bin/git-tidy" > /dev/null 2>&1)
check "merged domain-fix deleted" "! git -C '$tmp/repo' show-ref --verify -q refs/heads/domain-fix"
check "unmerged wip kept" "git -C '$tmp/repo' show-ref --verify -q refs/heads/wip"
check "main kept" "git -C '$tmp/repo' show-ref --verify -q refs/heads/main"
check "a dropped stash is still recoverable" "git -C '$tmp/repo' cat-file -e '$dropped'"

# obsidian-vault capture writes into the repository, so it refuses an installed copy. The fixture stands in for the repository.
fix="$tmp/fix"
mkdir -p "$fix/obsidian" "$tmp/data" "$tmp/vault/.obsidian"
git init -q "$fix"
echo '{}' > "$tmp/vault/.obsidian/app.json"
ln -s "$fix" "$tmp/data/bootstrap-repo"
DOTFILES="$fix" MISE_DATA_DIR="$tmp/data" OBSIDIAN_VAULT="$tmp/vault" "$root/bin/obsidian-vault" capture > "$tmp/cap.out" 2>&1
check "capture refuses an installed copy" "[ $? -ne 0 ] && grep -q 'installed copy' '$tmp/cap.out'"
check "capture wrote nothing into it" "[ ! -e '$fix/obsidian/.obsidian' ]"
DOTFILES="$fix" MISE_DATA_DIR="$tmp/none" OBSIDIAN_VAULT="$tmp/vault" "$root/bin/obsidian-vault" capture > /dev/null 2>&1
check "capture still writes into a clone" "[ -f '$fix/obsidian/.obsidian/app.json' ]"

# push: a git stub answers only `remote get-url --push`, so the push itself goes to a local bare repository, and a gh stub keeps the network out
mkdir "$tmp/stub"
printf '#!/bin/bash\nif [ "$1 $2 $3" = "remote get-url --push" ]; then echo "$PUSH_URL"; exit 0; fi\nexec %q "$@"\n' "$(command -v git)" > "$tmp/stub/git"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"
chmod +x "$tmp/stub/git" "$tmp/stub/gh"
git init -q --bare -b main "$tmp/origin.git"
git -C "$tmp/repo" remote add origin "$tmp/origin.git"
n=0
for u in git@github.com:o/r.git git@github.com:o/r ssh://git@github.com/o/r.git https://github.com/o/r.git; do
  n=$((n + 1))
  git -C "$tmp/repo" checkout -qb "feat$n" main
  (cd "$tmp/repo" && PATH="$tmp/stub:$PATH" PUSH_URL=$u "$root/bin/push") > "$tmp/push.out" 2>&1
  check "push $u: compare URL" "[ \"\$(tail -1 '$tmp/push.out')\" = https://github.com/o/r/compare/main...feat$n ]"
  check "push $u: no missing command" "! grep -q 'command not found' '$tmp/push.out'"
done
git -C "$tmp/repo" checkout -qb feat-lab main
(cd "$tmp/repo" && PATH="$tmp/stub:$PATH" PUSH_URL=https://gitlab.com/o/r.git "$root/bin/push") > "$tmp/push.out" 2>&1
check "push to another host: exits 0 and prints no URL" "[ $? -eq 0 ] && ! grep -q '^https://' '$tmp/push.out'"
git -C "$tmp/repo" checkout -q main

# pull on a rebase conflict rolls all the way back: no rebase left, the stash restored
git -C "$tmp/repo" push -q origin main
git clone -q "$tmp/origin.git" "$tmp/other"
(cd "$tmp/other" && echo theirs > top.txt && git commit -qam theirs && git push -q origin main)
(cd "$tmp/repo" && echo ours > top.txt && git commit -qam ours && echo dirty > untracked.txt)
(cd "$tmp/repo" && "$root/bin/pull") > "$tmp/pull.out" 2>&1
check "pull on a conflict: exits non-zero" "[ $? -ne 0 ]"
check "pull on a conflict: no rebase left behind" "[ ! -d '$tmp/repo/.git/rebase-merge' ]"
check "pull on a conflict: the stash is restored" "[ -z \"\$(git -C '$tmp/repo' stash list)\" ] && [ -f '$tmp/repo/untracked.txt' ]"
rm -f "$tmp/repo/untracked.txt"
(cd "$tmp/repo" && "$root/bin/pull") > "$tmp/pull.out" 2>&1
check "pull on a conflict with nothing stashed: no rebase, no stash pop" "[ ! -d '$tmp/repo/.git/rebase-merge' ] && ! grep -q 'Restoring tree' '$tmp/pull.out'"

[ "$fails" -eq 0 ] || {
  echo "$fails failed" >&2
  exit 1
}
