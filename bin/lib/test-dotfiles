#!/bin/bash
#
# Self-check for conf.d/40-dotfiles.toml in a scratch HOME.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-dotfiles`
#
# ---
# Applies the tracked fragment with the real mise. HOME, the mise config dir
# and mise's state all live under a temp dir, so only scratch links are made.
# Skips the apply checks with a note when mise is not installed.
#
# License: MIT

# shellcheck disable=SC2088 # "~/x" in messages is display text
set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd -P)"
fragment="$repo/tilde/.config/mise/conf.d/40-dotfiles.toml"
# The module fragments that link rules of their own
modfrags=("$repo/tilde/.config/mise/conf.d/60-rotm-agents.toml" "$repo/tilde/.config/mise/conf.d/60-rotm-claude.toml")

fail() {
  echo "test-dotfiles: $1" >&2
  exit 1
}

# Needs no mise: everything in tilde/ that is linked one by one has an entry
for path in "$repo"/tilde/.[!.]* "$repo"/tilde/.config/* "$repo"/tilde/.claude/* "$repo"/tilde/.claude/skills/*; do
  rel=${path#"$repo"/tilde/}
  case "$rel" in
    .DS_Store | */.DS_Store | .claude | .config | .claude/skills | .codex | .ssh) continue ;;
    # The wrappers config.rotm-installed.toml seeds, never linked themselves
    *.installed) continue ;;
  esac
  grep -qF "\"~/$rel\" = " "$fragment" || fail "no [dotfiles] entry for ~/$rel"
done

installed="$repo/tilde/.config/mise/config.rotm-installed.toml"
[ -f "$installed" ] || fail "config.rotm-installed.toml is missing"
# Each key redeclares a base entry, or sits inside a folder this file makes real
while IFS= read -r key; do
  grep -qF "\"$key\" = " "$fragment" && continue
  grep -qF "\"${key%/*}\" = { permissions" "$installed" && continue
  # or is a seeded copy of a file its folder's symlink-each entry excludes
  grep -F "\"${key%/*}\" = " "$installed" | grep -F 'mode = "symlink-each", exclude = [' | grep -qF "\"${key##*/}\"" \
    || fail "config.rotm-installed.toml declares $key, which redeclares nothing and is in no folder it makes real"
done < <(sed -n 's/^"\([^"]*\)" = .*/\1/p' "$installed")
# A redeclared symlink-each entry may only change its exclude list
while IFS= read -r line; do
  base=$(grep -F "${line%% = *} = " "$fragment" || true)
  [ "${line%, exclude = *}" = "${base%, exclude = *}" ] || fail "config.rotm-installed.toml changes more than the exclude list of ${line%% = *}"
done < <(grep -E '^"[^"]*" = .*mode = "symlink-each", exclude = ' "$installed")
# A symlink here would put app writes back in the checkout
if grep -E '^"' "$installed" | grep -vE 'mode = "copy", create_if_missing = true|merge = |= \{ permissions = "[0-7]+" \}|mode = "symlink-each", exclude = ' | grep -q .; then
  fail "config.rotm-installed.toml has an entry that is neither create_if_missing, merge, a real folder nor an exclude-only symlink-each"
fi

# tilde/.ssh/config: each 1Password block applies only when its file exists.
# ssh takes %d and ~ from the account, so a copy points both at a scratch home.
# A socket path is limited to 104 bytes, hence the short /tmp folder.
ssh_tmp=$(mktemp -d /tmp/rotm.XXXXXX)
trap 'rm -rf "$ssh_tmp"' EXIT
sock="Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
ssh_case() { # <case> <host> <must grep -E...> [-- <must not grep -E>]
  local name=$1 h="$ssh_tmp/$1" host=$2 out
  shift 2
  sed -e '/^Include /d' -e "s|%d|$h|g" -e "s|~|$h|g" "$repo/tilde/.ssh/config" > "$h.config"
  out=$(ssh -T -G -F "$h.config" "$host" | grep -iE '^(identitiesonly|identityfile|identityagent) ' | grep -iE "identitiesonly|$h" || true)
  while [ $# -gt 0 ]; do
    if [ "$1" = -- ]; then
      ! grep -qiE "$2" <<< "$out" || fail "tilde/.ssh/config: $name resolved to $out"
      shift 2
      continue
    fi
    grep -qiE "$1" <<< "$out" || fail "tilde/.ssh/config: $name resolved to $out"
    shift
  done
}
make_sock() { mkdir -p "$(dirname "$1")" && python3 -c 'import socket,sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$1"; }
mkdir -p "$ssh_tmp/nothing" "$ssh_tmp/pub/.ssh"
touch "$ssh_tmp/pub/.ssh/github_personal.pub"
make_sock "$ssh_tmp/socket/$sock"
mkdir -p "$ssh_tmp/both/.ssh" && touch "$ssh_tmp/both/.ssh/github_personal.pub"
make_sock "$ssh_tmp/both/$sock"
ssh_case nothing github.com '^identitiesonly no$' -- '^identityagent .*1password'
ssh_case pub github.com '^identitiesonly yes$' "^identityfile $ssh_tmp/pub/.ssh/github_personal.pub$" -- '^identityagent .*1password'
ssh_case socket github.com '^identitiesonly no$' "^identityagent \"?$ssh_tmp/socket/$sock\"?$"
ssh_case both example.com '^identitiesonly no$' "^identityagent \"?$ssh_tmp/both/$sock\"?$"
rm -rf "$ssh_tmp"

command -v mise > /dev/null || {
  echo "test-dotfiles: mise not found, skipping the apply checks" >&2
  exit 0
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
home="$tmp/home"
mkdir -p "$home" "$tmp/cfg/conf.d"
cp "$fragment" "${modfrags[@]}" "$tmp/cfg/conf.d/"
ln -s "$repo" "$home/dotfiles"

# MISE_CONFIG_DIR only (never MISE_GLOBAL_CONFIG_FILE); the ceiling keeps a
# config above the temp dir out. Not run from $home: once applied, its
# ~/.config/mise links to the clone and mise would read that as project config.
m() {
  (cd "$tmp" && env -i HOME="$home" PATH="$PATH" MISE_CONFIG_DIR="$tmp/cfg" MISE_STATE_DIR="$tmp/state" \
    MISE_DATA_DIR="$tmp/data" MISE_CACHE_DIR="$tmp/cache" MISE_CEILING_PATHS="$tmp" mise "$@")
}
# Every link and file under the scratch HOME, with its target
snapshot() { (cd "$home" && find . \( -type l -o -type f \) -exec stat -f '%N %Y %Sp' {} + | sort); }

# Nothing here may reach the real HOME or read the clone's live mise config
[ "$home" != "$HOME" ] && [ ! "$home" -ef "$HOME" ] || fail "the scratch HOME is the real HOME"
only_scratch_config() {
  ! m config ls --no-header 2>&1 | awk '{print $1}' | grep -qvF "$tmp/cfg/conf.d/" || fail "mise reads a config outside the scratch dir: $(m config ls 2>&1)"
}
only_scratch_config

m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "first apply failed: $(cat "$tmp/out")"
only_scratch_config
m dotfiles status --missing > "$tmp/out" 2>&1 || fail "status --missing after apply: $(cat "$tmp/out")"

[ "$home/.zshrc" -ef "$repo/tilde/.zshrc" ] || fail "~/.zshrc is not the tracked file"
[ -d "$home/.claude/rules" ] && [ ! -L "$home/.claude/rules" ] || fail "~/.claude/rules is not a real directory"
[ -d "$home/.claude/skills" ] && [ ! -L "$home/.claude/skills" ] || fail "~/.claude/skills is not a real directory"
[ -L "$home/.claude/rules/index.md" ] || fail "rules are not linked one by one"
for rule in rtk hindsight catalog; do
  [ -L "$home/.claude/rules/$rule.md" ] || fail "modules on: $rule.md is not linked"
done
[ -L "$home/.config/gh" ] && [ ! -L "$home/.config" ] || fail "~/.config children are not linked one by one"
ff="$home/.config/fastfetch"
[ -d "$ff" ] && [ ! -L "$ff" ] && [ "$ff/config.jsonc" -ef "$repo/tilde/.config/fastfetch/config.jsonc" ] && [ -r "$ff/ascii/deadpool-katanas.ascii" ] \
  || fail "~/.config/fastfetch is not a real folder of links"
[ ! -e "$home/README.md" ] || fail "tilde/README.md was linked"
[ -f "$home/.codex/config.toml" ] && [ ! -L "$home/.codex/config.toml" ] || fail "codex config is not a regular file"
[ "$(stat -f %Lp "$home/.codex/config.toml")" = 600 ] || fail "codex config is not 0600"
[ "$(stat -f %Lp "$home/.ssh")" = 700 ] && [ "$(stat -f %Lp "$home/.gnupg")" = 700 ] || fail "~/.ssh or ~/.gnupg is not 0700"
[ ! -L "$home/.ssh" ] && [ ! -L "$home/.codex" ] || fail "~/.ssh or ~/.codex is linked as a folder"

before=$(snapshot)
m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "second apply failed: $(cat "$tmp/out")"
[ "$before" = "$(snapshot)" ] || fail "a second apply changed something"

# Codex config, merge = "missing": the Mac's values and keys stay, missing keys come back
codex="$home/.codex/config.toml"
sed -i '' -e 's/^model = .*/model = "mine"/' -e '/^sandbox_mode = /d' "$codex"
echo "token = 1" >> "$codex"
m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "apply over an edited codex config failed: $(cat "$tmp/out")"
grep -qx 'model = "mine"' "$codex" || fail "the merge replaced a value the Mac set"
grep -qx 'token = 1' "$codex" || fail "the merge dropped a key only the Mac has"
grep -q '^sandbox_mode = ' "$codex" || fail "the merge did not add a missing key"
cp "$codex" "$tmp/codex.merged"
m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "apply after the merge failed: $(cat "$tmp/out")"
cmp -s "$codex" "$tmp/codex.merged" || fail "a second apply changed the merged codex config"

# An invalid live config is reported and never rewritten
printf 'model = \n' > "$codex"
cp "$codex" "$tmp/codex.bad"
if m dotfiles apply --yes > "$tmp/out" 2>&1; then fail "apply succeeded over an invalid codex config"; fi
grep -q 'failed to parse the TOML target' "$tmp/out" || fail "invalid codex config not reported: $(cat "$tmp/out")"
cmp -s "$codex" "$tmp/codex.bad" || fail "an invalid codex config was rewritten"
cp "$tmp/codex.merged" "$codex"

# A real file in the way: apply fails, names it, and writes nothing at all
rm "$home/.zshrc" "$home/.gitmessage"
echo mine > "$home/.zshrc"
before=$(snapshot)
if m dotfiles apply --yes > "$tmp/out" 2>&1; then fail "apply succeeded over a real ~/.zshrc"; fi
grep -q 'refusing to overwrite' "$tmp/out" && grep -qx '  ~/.zshrc' "$tmp/out" || fail "conflict not reported: $(cat "$tmp/out")"
[ "$(cat "$home/.zshrc")" = mine ] || fail "the real ~/.zshrc was touched"
[ "$before" = "$(snapshot)" ] || fail "a refused apply still wrote something"
if m dotfiles status --missing > /dev/null 2>&1; then fail "status --missing passed with a conflict"; fi

# A link that points elsewhere is repointed without --force
rm "$home/.zshrc"
ln -s /etc/hosts "$home/.zshrc"
m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "apply over a foreign link failed: $(cat "$tmp/out")"
[ "$home/.zshrc" -ef "$repo/tilde/.zshrc" ] || fail "a foreign link was not repointed"

# A Mac's own Mole list: config.local.toml replaces the entry, without --force
echo local > "$tmp/whitelist.local"
printf '[dotfiles]\n"~/.config/mole/whitelist" = { source = "%s", mode = "symlink" }\n' "$tmp/whitelist.local" > "$tmp/cfg/config.local.toml"
m dotfiles apply --yes > "$tmp/out" 2>&1 || fail "apply with a config.local.toml entry failed: $(cat "$tmp/out")"
[ "$home/.config/mole/whitelist" -ef "$tmp/whitelist.local" ] || fail "config.local.toml did not replace the Mole entry"
rm "$tmp/cfg/config.local.toml"

# Without ~/dotfiles no source resolves: apply fails and writes nothing
rm "$home/dotfiles" "$home/.gitmessage"
before=$(snapshot)
if m dotfiles apply --yes > "$tmp/out" 2>&1; then fail "apply succeeded without ~/dotfiles"; fi
grep -q 'sources do not exist' "$tmp/out" || fail "missing ~/dotfiles not reported: $(cat "$tmp/out")"
[ "$before" = "$(snapshot)" ] || fail "an apply without ~/dotfiles still wrote something"

# The agents and claude modules off, in a scratch HOME of their own: their rules are not linked
off_home="$tmp/offhome"
mkdir -p "$off_home" "$tmp/cfgoff/conf.d"
cp "$fragment" "${modfrags[@]}" "$tmp/cfgoff/conf.d/"
printf 'ignored_config_paths = ["conf.d/60-rotm-agents.toml", "conf.d/60-rotm-claude.toml"]\n' > "$tmp/cfgoff/miserc.local.toml"
ln -s "$repo" "$off_home/dotfiles"
moff() {
  (cd "$tmp" && env -i HOME="$off_home" PATH="$PATH" MISE_CONFIG_DIR="$tmp/cfgoff" MISE_STATE_DIR="$tmp/stateoff" \
    MISE_DATA_DIR="$tmp/dataoff" MISE_CACHE_DIR="$tmp/cacheoff" MISE_CEILING_PATHS="$tmp" mise "$@")
}
# rotm-modules trusts an ignored file, which mise's dotfiles history still reads (test-modules covers why)
moff trust "$tmp/cfgoff/conf.d/60-rotm-agents.toml" > /dev/null 2>&1 || fail "agents and claude off: mise trust failed"
moff dotfiles apply --yes > "$tmp/out" 2>&1 || fail "agents and claude off: apply failed: $(cat "$tmp/out")"
for rule in rtk hindsight catalog; do
  [ ! -e "$off_home/.claude/rules/$rule.md" ] || fail "agents and claude off: $rule.md is still linked"
done
[ -L "$off_home/.claude/rules/verify-first.md" ] || fail "agents and claude off: the base rules are not linked"

# A home set up when the base entry still linked the module rules keeps them after ONE apply
mig_home="$tmp/mighome"
mkdir -p "$mig_home" "$tmp/cfgmig/conf.d"
old_fastfetch='"~/.config/fastfetch" = { source = "~/dotfiles/tilde/.config/fastfetch", mode = "symlink" }'
sed -e 's/, "rtk.md", "hindsight.md", "catalog.md"//' -e "s|^\"~/.config/fastfetch\" = .*|$old_fastfetch|" "$fragment" > "$tmp/cfgmig/conf.d/40-dotfiles.toml"
grep -qxF "$old_fastfetch" "$tmp/cfgmig/conf.d/40-dotfiles.toml" || fail "migration: could not rebuild the old ~/.config/fastfetch entry"
cp "$tmp/cfgmig/conf.d/40-dotfiles.toml" "$tmp/cfgmig-old.toml"
grep -qF '"~/.claude/rules" = { source = "~/dotfiles/tilde/.claude/rules", mode = "symlink-each", exclude = [".DS_Store"] }' "$tmp/cfgmig/conf.d/40-dotfiles.toml" \
  || fail "migration: could not rebuild the old ~/.claude/rules entry"
ln -s "$repo" "$mig_home/dotfiles"
mmig() {
  (cd "$tmp" && env -i HOME="$mig_home" PATH="$PATH" MISE_CONFIG_DIR="$tmp/cfgmig" MISE_STATE_DIR="$tmp/statemig" \
    MISE_DATA_DIR="$tmp/datamig" MISE_CACHE_DIR="$tmp/cachemig" MISE_CEILING_PATHS="$tmp" mise "$@")
}
mmig dotfiles apply --yes > "$tmp/out" 2>&1 || fail "migration: old-layout apply failed: $(cat "$tmp/out")"
[ -L "$mig_home/.config/fastfetch" ] || fail "migration: the old layout did not link ~/.config/fastfetch as a folder"
cp "$fragment" "${modfrags[@]}" "$tmp/cfgmig/conf.d/"
mmig dotfiles apply --yes > "$tmp/out" 2>&1 || fail "migration: apply failed: $(cat "$tmp/out")"
for rule in rtk hindsight catalog; do
  [ -L "$mig_home/.claude/rules/$rule.md" ] || fail "migration: $rule.md is gone after one apply"
done
mmig dotfiles status --missing > "$tmp/out" 2>&1 || fail "migration: status --missing after one apply: $(cat "$tmp/out")"
# The old folder link becomes a real folder, and nothing is written through it into the repo
ff="$mig_home/.config/fastfetch"
[ ! -L "$ff" ] && [ -r "$ff/config.jsonc" ] && [ -r "$ff/ascii/deadpool-katanas.ascii" ] || fail "migration: ~/.config/fastfetch lost a file or is still a link"
[ -z "$(find "$repo/tilde/.config/fastfetch" -type l)" ] || fail "migration: the apply wrote a link into the repo's fastfetch folder"

# The installed environment, in a second scratch HOME: the targets apps write
# to are real files and folders, seeded once and then left to their owner
home="$tmp/home2"
mkdir -p "$home" "$tmp/cfg2/conf.d"
cp "$fragment" "$tmp/cfg2/conf.d/"
cp "$installed" "$tmp/cfg2/"
ln -s "$repo" "$home/dotfiles"
mi() {
  (cd "$tmp" && env -i HOME="$home" PATH="$PATH" MISE_ENV=rotm-installed MISE_CONFIG_DIR="$tmp/cfg2" MISE_STATE_DIR="$tmp/state2" \
    MISE_DATA_DIR="$tmp/data2" MISE_CACHE_DIR="$tmp/cache2" MISE_CEILING_PATHS="$tmp" mise "$@")
}
mi dotfiles status > "$tmp/out" 2>&1 || true
grep -q '^~/\.config/gh/config\.yml  *copy ' "$tmp/out" || fail "installed: ~/.config/gh/config.yml is not listed as a copy: $(cat "$tmp/out")"
grep -q '^~/\.gitconfig  *copy ' "$tmp/out" || fail "installed: ~/.gitconfig is not a copy: $(cat "$tmp/out")"
mi dotfiles apply --yes > "$tmp/out" 2>&1 || fail "installed: apply failed: $(cat "$tmp/out")"
[ ! -L "$home/.gitconfig" ] && cmp -s "$home/.gitconfig" "$repo/tilde/.gitconfig.installed" || fail "installed: ~/.gitconfig is not the seeded wrapper"
[ ! -L "$home/.zshrc" ] && cmp -s "$home/.zshrc" "$repo/tilde/.zshrc.installed" || fail "installed: ~/.zshrc is not the seeded wrapper"
[ "$(HOME="$home" git config --file "$home/.gitconfig" --includes --get core.excludesfile)" = "$(git config --file "$repo/tilde/.gitconfig" --get core.excludesfile)" ] \
  || fail "installed: git does not read the tracked settings through the wrapper"
printf '[x]\n  y = 1\n' > "$home/.gitconfig.local"
[ "$(HOME="$home" git config --file "$home/.gitconfig" --includes --get-all x.y | wc -l | tr -d ' ')" = 1 ] \
  || fail "installed: ~/.gitconfig.local is read more than once"
[ -d "$home/.config/gh" ] && [ ! -L "$home/.config/gh" ] && [ -f "$home/.config/gh/config.yml" ] && [ ! -L "$home/.config/gh/config.yml" ] \
  || fail "installed: ~/.config/gh is not a real folder with a real config.yml"
for f in whitelist whitelist_optimize; do
  [ ! -L "$home/.config/mole/$f" ] && cmp -s "$home/.config/mole/$f" "$repo/mole/$f" || fail "installed: ~/.config/mole/$f is not a seeded copy"
done
code_user="$home/Library/Application Support/Code/User"
[ ! -L "$code_user" ] && [ -f "$code_user/snippets/global.code-snippets" ] && [ ! -L "$code_user/keybindings.json" ] \
  || fail "installed: Code/User is not a real folder with seeded files"
[ -L "$home/.zshenv" ] || fail "installed: an entry the environment does not name is no longer a link"
roles="$home/.claude/rules/jstack-models.md"
[ ! -L "$roles" ] && cmp -s "$roles" "$repo/tilde/.claude/rules/jstack-models.md" || fail "installed: jstack-models.md is not a seeded copy"
[ -L "$home/.claude/rules/verify-first.md" ] || fail "installed: the other rules are no longer links"
ffconfig="$home/.config/fastfetch/config.jsonc"
# Not through a folder link: the edit below would then land in the repo
[ ! -L "$home/.config/fastfetch" ] && [ -f "$ffconfig" ] && [ ! -L "$ffconfig" ] && cmp -s "$ffconfig" "$repo/tilde/.config/fastfetch/config.jsonc" || fail "installed: fastfetch's config.jsonc is not a seeded copy"
[ -r "$home/.config/fastfetch/ascii/deadpool-katanas.ascii" ] || fail "installed: fastfetch's logo is not readable"
# What the user or an app writes afterwards stays, and never reaches the checkout
echo "# mine" >> "$home/.gitconfig"
echo "editor: vim" >> "$home/.config/gh/config.yml"
echo "# mine" >> "$roles"
echo "// mine" >> "$ffconfig"
mi dotfiles apply --yes > "$tmp/out" 2>&1 || fail "installed: second apply failed: $(cat "$tmp/out")"
grep -qx '# mine' "$home/.gitconfig" && grep -qx 'editor: vim' "$home/.config/gh/config.yml" && grep -qx '# mine' "$roles" && grep -qx '// mine' "$ffconfig" \
  || fail "installed: a second apply overwrote a seeded file"

# An installed copy made when ~/.config/fastfetch was one folder link gets its own config.jsonc after ONE apply
home="$tmp/home3"
mkdir -p "$home" "$tmp/cfg3/conf.d"
cp "$tmp/cfgmig-old.toml" "$tmp/cfg3/conf.d/40-dotfiles.toml"
grep -v -e fastfetch -e mole "$installed" > "$tmp/cfg3/config.rotm-installed.toml"
ln -s "$repo" "$home/dotfiles"
mi3() {
  (cd "$tmp" && env -i HOME="$home" PATH="$PATH" MISE_ENV=rotm-installed MISE_CONFIG_DIR="$tmp/cfg3" MISE_STATE_DIR="$tmp/state3" \
    MISE_DATA_DIR="$tmp/data3" MISE_CACHE_DIR="$tmp/cache3" MISE_CEILING_PATHS="$tmp" mise "$@")
}
mi3 dotfiles apply --yes > "$tmp/out" 2>&1 || fail "installed migration: old-layout apply failed: $(cat "$tmp/out")"
[ -L "$home/.config/fastfetch" ] || fail "installed migration: the old layout did not link ~/.config/fastfetch as a folder"
cp "$fragment" "$tmp/cfg3/conf.d/"
cp "$installed" "$tmp/cfg3/"
mi3 dotfiles apply --yes > "$tmp/out" 2>&1 || fail "installed migration: apply failed: $(cat "$tmp/out")"
ffconfig="$home/.config/fastfetch/config.jsonc"
[ ! -L "$home/.config/fastfetch" ] && [ -f "$ffconfig" ] && [ ! -L "$ffconfig" ] && [ -r "$home/.config/fastfetch/ascii/deadpool-katanas.ascii" ] \
  || fail "installed migration: no config.jsonc of its own after one apply"
# mise leaves a file that is already there alone, link or not, so a Mac installed before the seed keeps its link
[ -L "$home/.config/mole/whitelist" ] || fail "installed migration: an existing whitelist link was replaced, so docs/mole.md's hand step is out of date"

echo ok
