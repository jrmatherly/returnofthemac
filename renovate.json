{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true },
  "mise": {
    "managerFilePatterns": ["tilde/.config/mise/conf.d/60-rotm-*.toml"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["@ampcode/plugin"],
      "schedule": ["* 0-3 * * 1"],
      "updateNotScheduled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["azure-functions-core-tools"],
      "allowedVersions": "<5"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["node", "python"],
      "enabled": false
    },
    {
      "description": "The Hindsight daemon moves with its hook package, behind a database backup: docs/superpowers/specs/completed/2026-11-13-hindsight-daemon-environment-and-uv-cache.md. The requires-python range is the lock's, so a bump is `uv lock --directory hindsight` in a reviewed commit",
      "matchFileNames": ["hindsight/pyproject.toml"],
      "enabled": false
    },
    {
      "description": "check.yml pins mise to the floor in setup/mise-floor.sh, and bin/lib/test-override-env fails when they differ. Raise both by hand in one commit",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["jdx/mise"],
      "enabled": false
    }
  ]
}
